NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: used as the base URL for auth redirects (OAuth / magic link).
# Defaults to the request origin at runtime when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth (Email, Google OAuth, magic link) requires no additional env vars:
# providers are configured in the Supabase dashboard under
# Authentication -> Providers. Only the URL + anon key above are needed.