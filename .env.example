NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: used for metadata and canonical URLs. Auth callbacks use the
# current request origin. Set this to https://mainpot.app in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show Google sign-in only after the Google provider credentials are enabled
# in Supabase Authentication -> Providers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional private, self-hosted Product Ops integration. Disabled by default.
NEXT_PUBLIC_PRODUCT_OPS_ENABLED=false
PRODUCT_OPS_ENDPOINT=http://product-ops.home
PRODUCT_OPS_INGESTION_KEY=
PRODUCT_OPS_ACTOR_SALT=

# Provider secrets stay in Supabase and must never be added to this file.
