NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key used to fan game notifications out to participating devices.
# Never prefix this value with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Web Push delivery. Generate a pair with `npm run push:generate-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Optional: used for metadata and canonical URLs. Auth callbacks use the
# current request origin. Set this to https://mainpot.app in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show Google sign-in only after the Google provider credentials are enabled
# in Supabase Authentication -> Providers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional Product Ops telemetry. Disabled by default. When enabled, Mainpot
# writes only HMAC-pseudonymized, allowlisted events to its Supabase outbox.
# The Product Ops collector pulls that outbox over a server-to-server connection;
# no Product Ops endpoint or ingestion key belongs in this application.
NEXT_PUBLIC_PRODUCT_OPS_ENABLED=false
# Server-only HMAC salt. Never prefix with NEXT_PUBLIC_ or expose in browser code.
PRODUCT_OPS_ACTOR_SALT=
# App-scoped bearer token for the private collector's GET pull requests. Use a
# random value of at least 32 characters on Mainpot and the tailnet collector;
# never expose it to browsers.
PRODUCT_OPS_COLLECTOR_KEY=

# Separate app-scoped bearer token for POST /api/health/canary. Use a random
# value of at least 32 characters only in the monitor and Mainpot deployment.
MAINPOT_CANARY_KEY=

# A private support inbox shown in the feedback and privacy flows. Set this
# before going live; it is intentionally safe to expose in the browser.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Provider secrets stay in Supabase and must never be added to this file.
